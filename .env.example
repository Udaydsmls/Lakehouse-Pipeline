# Copy to .env and adjust if you changed anything in docker-compose.yml.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CLICKSTREAM_TOPIC=clickstream.events
EVENTS_PER_SECOND=50

# Postgres (source database + Airflow metadata + dbt target)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO (stands in for S3)
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Iceberg raw zone (written by Flink, read by Spark)
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3a://lakehouse-raw/warehouse

# Delta Lake curated zone (written by Spark)
DELTA_WAREHOUSE=s3a://lakehouse-curated

# Spark / Flink
SPARK_MASTER=local[*]
FLINK_PARALLELISM=2
