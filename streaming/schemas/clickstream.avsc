{
  "type": "record",
  "name": "ClickstreamEvent",
  "namespace": "com.lakehouse.clickstream",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["page_view","product_view","search","add_to_cart","remove_from_cart","checkout_start","purchase"]}},
    {"name": "user_id", "type": "string"},
    {"name": "session_id", "type": "string"},
    {"name": "product_id", "type": ["null", "string"], "default": null},
    {"name": "page_url", "type": "string"},
    {"name": "referrer", "type": ["null", "string"], "default": null},
    {"name": "device_type", "type": {"type": "enum", "name": "DeviceType", "symbols": ["desktop","mobile","tablet"]}},
    {"name": "user_agent", "type": "string"},
    {"name": "ip_address", "type": "string"},
    {"name": "country", "type": "string"},
    {"name": "timestamp", "type": "string"}
  ]
}
