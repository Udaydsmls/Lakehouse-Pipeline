{
  "type": "record",
  "name": "InventoryEvent",
  "namespace": "com.lakehouse.inventory",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "product_id", "type": "string"},
    {"name": "event_type", "type": {"type": "enum", "name": "InventoryEventType", "symbols": ["stock_updated","restock_alert","out_of_stock","discontinued"]}},
    {"name": "warehouse_id", "type": "string"},
    {"name": "quantity_on_hand", "type": "int"},
    {"name": "quantity_reserved", "type": "int"},
    {"name": "reorder_point", "type": "int"},
    {"name": "timestamp", "type": "string"}
  ]
}
